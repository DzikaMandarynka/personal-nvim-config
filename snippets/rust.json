{
  "Rust Doc Comment": {
    "prefix": "rustdoc",
    "body": [
      "/// ${1:summary}",
      "",
      "/// ${2:description}",
      "///",
      "/// # Safety",
      "///",
      "/// ${3:invariants}",
      "///",
      "/// # Panics",
      "///",
      "/// ${4:panic conditions}",
      "///",
      "/// # Errors",
      "///",
      "/// ${5:error conditions}",
      "///",
      "/// # Examples",
      "///",
      "/// ```rust",
      "/// ${6:// example code}",
      "/// ```",
      "$0"
    ],
    "description": "Rust doc comment with Safety, Panics, Errors, Examples"
  },
  "Criterion Benchmark": {
    "prefix": "cnbench",
    "body": [
      "use criterion::{Criterion, criterion_group, criterion_main};",
      "",
      "fn bench_${1:name}(c: &mut Criterion) {",
      "    c.bench_function(\"${1:name}\", |b| {",
      "        b.iter(|| {",
      "            ${2:// code}",
      "        });",
      "    });",
      "}",
      "",
      "criterion_group!(benches, bench_${1:name});",
      "criterion_main!(benches);"
    ],
    "description": "Criterion benchmark template"
  }
}
